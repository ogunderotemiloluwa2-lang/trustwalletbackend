# MongoDB connection string (Atlas or local).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/trustwallet

# Random secret of at least 32 characters used to sign session tokens.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Local port. Render sets PORT itself, so this is only used when running locally.
API_PORT=5000

# Comma-separated list of browser origins allowed to call this API.
# Production example: https://your-app.vercel.app
CORS_ORIGIN=http://localhost:3000
